run = "streamlit run review_app.py --server.port 8080 --server.address 0.0.0.0 --server.headless true"
entrypoint = "review_app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "streamlit run review_app.py --server.port 8080 --server.address 0.0.0.0 --server.headless true"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80
