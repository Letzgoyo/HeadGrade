# Public site (what visitors see). The admin/review screen is separate: run it in the workspace shell, never in the deployment.
run = "gunicorn -b 0.0.0.0:8080 --workers 2 headgrade.wsgi:app"
entrypoint = "headgrade/site.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "gunicorn -b 0.0.0.0:8080 --workers 2 headgrade.wsgi:app"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80
